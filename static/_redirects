# Netlify redirects: old WordPress-era URLs -> current Hugo URLs.
# Netlify serves an existing file before checking these rules, so no
# current page can be shadowed. Rules are matched top to bottom, and a
# trailing slash is optional on both sides.
# Post slugs were kept when the site moved from WordPress, so a date-based
# URL only needs its date removed. Rules are limited to the years the site
# has posts, so nothing else with the same shape is caught.

# Feeds
/feed                       /index.xml                      301
/blog/feed                  /index.xml                      301
/rss                        /index.xml                      301
/category/:name/feed        /categories/:name/index.xml     301
/tag/:name/feed             /tags/:name/index.xml           301

# Category and tag archives
/category/:name             /categories/:name/              301
/category/:name/page/:n     /categories/:name/page/:n/      301
/blog/category/:name        /categories/:name/              301
/tag/:name                  /tags/:name/                    301
/tag/:name/page/:n          /tags/:name/page/:n/            301
/blog/tag/:name             /tags/:name/                    301

# Old WordPress page URLs under /blog/
/blog/about                 /about/                         301
/blog/contact               /contact/                       301

# Posts whose slug changed; old links in Jordan's own posts still point at these
/blog/1-password            /blog/1password/                301
/blog/book-musings          /blog/book-musing/              301
/blog/reflecting-on-2014    /blog/reflecting-on-the-year/   301

# Uploaded files: WordPress stored them by year and month; Hugo serves them from /images/
/wp-content/uploads/:year/:month/:file    /images/:file    301

# Date-based post URLs: /YYYY/MM/slug/, /blog/YYYY/MM/slug/, and the
